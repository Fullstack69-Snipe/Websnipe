{
  "name": "db",
  "version": "1.0.0",
  "description": "ชั้นฐานข้อมูล (PostgreSQL + Drizzle) ของระบบยืม-คืนอุปกรณ์",
  "main": "./dist/cjs/db/index.js",
  "types": "./dist/cjs/db/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/db/index.d.ts",
        "default": "./dist/db/index.js"
      },
      "require": {
        "types": "./dist/cjs/db/index.d.ts",
        "default": "./dist/cjs/db/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts",
    "prototype": "tsx db/prototype.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc && tsc-alias",
    "build:cjs": "tsc -p tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json && node scripts/finalize-cjs.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/node-ts": "^23.6.4",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eol-converter-cli": "^1.1.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
