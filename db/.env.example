# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง
#   cp .env.example .env

# --- superuser ของ container (ใช้ตอน init เท่านั้น ไม่ได้ใช้เชื่อมต่อจากแอป) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-root
POSTGRES_DB=preflight

# --- user ที่แอป/drizzle ใช้เชื่อมต่อจริง (_entrypoint/init.sh สร้างให้) ---
POSTGRES_APP_USER=preflight_app
POSTGRES_APP_PASSWORD=change-me-app

# --- ปลายทางที่ฝั่ง node เชื่อมต่อ (ดู db/utils.ts) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
