# คัดลอกเป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง
#   cp .env.example .env
# ใช้กับ docker-compose.yml ที่ root (รันทั้งระบบ)

# --- superuser ของ container postgres (ใช้ตอน init เท่านั้น) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-root
POSTGRES_DB=preflight

# --- user ที่ backend ใช้เชื่อมต่อจริง (db/_entrypoint/init.sh สร้างให้) ---
POSTGRES_APP_USER=preflight_app
POSTGRES_APP_PASSWORD=change-me-app

# พอร์ต postgres ที่เปิดออกมาที่เครื่อง (สำหรับ drizzle-kit / db studio)
POSTGRES_PORT=5432

# --- frontend ---
# พอร์ตที่เปิดเว็บ: http://localhost:6002
NGINX_PORT=6002
# ปลายทางที่ nginx proxy /api ไปหา (ชื่อ service ใน network)
NGINX_PROXY=http://pf-backend:3000

# --- เข้าสู่ระบบด้วย OAuth ---
# URL ที่ผู้ใช้เปิดเว็บจริง ใช้ประกอบ redirect_uri ที่ส่งให้ provider
# ต้องตรงกับที่ลงทะเบียนไว้ฝั่ง Google/GitHub เป๊ะ
APP_URL=http://localhost:6002

# Google: console.cloud.google.com -> APIs & Services -> Credentials
#   Authorized redirect URI: http://localhost:6002/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: github.com/settings/developers -> New OAuth App
#   Authorization callback URL: http://localhost:6002/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord: discord.com/developers/applications -> New Application -> OAuth2
#   Redirects: http://localhost:6002/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# อายุ session (วัน)
SESSION_DAYS=30

# อีเมลที่ได้สิทธิ์ admin อัตโนมัติตอนเข้าสู่ระบบ (คั่นด้วย comma)
# จำเป็นสำหรับ admin คนแรก เพราะผู้สมัครใหม่ทุกคนได้ role 'user'
# ใส่อีเมลตัวเองไว้ จะได้เข้าหน้า "จัดการผู้ใช้" แล้วตั้งสิทธิ์คนอื่นต่อได้
ADMIN_EMAILS=

# origin ที่อนุญาตให้เรียก API แบบแนบคุกกี้ (คั่นด้วย comma)
CORS_ORIGINS=http://localhost:5173,http://localhost:6002
