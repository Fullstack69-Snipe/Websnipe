# คัดลอกเป็น .env — ใช้ตอนรัน backend เดี่ยวๆ (docker compose ในโฟลเดอร์นี้)
# ถ้ารันทั้งระบบด้วย docker-compose.yml ที่ root ให้ตั้งค่าที่ .env ของ root แทน

PORT=3000

# ที่เก็บรูปที่อัปโหลด
UPLOAD_DIR=./uploads

# --- เข้าสู่ระบบด้วย OAuth (ว่างไว้ = ปิดช่องทางนั้น) ---
APP_URL=http://localhost:6002
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_DAYS=30

# --- ฐานข้อมูล PostgreSQL (ต้องตรงกับที่ db/ ตั้งไว้) ---
# ใน container ใช้ pf-db, รันบนเครื่องตัวเองใช้ localhost
POSTGRES_HOST=pf-db
POSTGRES_PORT=5432
POSTGRES_DB=preflight
POSTGRES_APP_USER=preflight_app
POSTGRES_APP_PASSWORD=change-me-app

# ใส่ข้อมูลตั้งต้นให้อัตโนมัติตอนบูต (ข้ามเองถ้ามีข้อมูลแล้ว)
RUN_SEED=true

# อีเมลที่ได้สิทธิ์ admin อัตโนมัติตอนเข้าสู่ระบบ (คั่นด้วย comma)
# จำเป็นสำหรับ admin คนแรก เพราะผู้สมัครใหม่ทุกคนได้ role 'user'
# ใส่อีเมลตัวเองไว้ จะได้เข้าหน้า "จัดการผู้ใช้" แล้วตั้งสิทธิ์คนอื่นต่อได้
ADMIN_EMAILS=

# origin ที่อนุญาตให้เรียก API แบบแนบคุกกี้ (คั่นด้วย comma)
CORS_ORIGINS=http://localhost:5173,http://localhost:6002
