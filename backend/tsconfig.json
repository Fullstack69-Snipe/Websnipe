{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@db/*": ["./db/*"],
      "@src/*": ["./src/*"]
    }
  },
  "include": ["./db/**/*.ts", "./drizzle.config.ts", "./src/**/*.ts"],
  "exclude": ["./dist"]
}